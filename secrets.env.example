# Ballast secrets template.
#
# Your real copy lives OUTSIDE the project folder, so it can never be committed,
# uploaded to GitHub, zipped or shared along with the code:
#
#     mkdir -p ~/.config/ballast
#     cp secrets.env.example ~/.config/ballast/secrets.env
#     chmod 600 ~/.config/ballast/secrets.env      # only your user account can read it
#
# Then open ~/.config/ballast/secrets.env and fill in your values.
# Never paste real values into THIS file: it is public.

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional overrides. The defaults match docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://ballast:ballast@localhost:5432/ballast
# TEST_DATABASE_URL=postgresql+psycopg://ballast:ballast@localhost:5432/ballast_test
